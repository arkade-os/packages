{
  "name": "@arkade-os/sats-connect-react",
  "version": "0.1.0",
  "description": "React bindings for Arkade SDK with Sats Connect wallets",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@arkade-os/boltz-swap": ">=0.3.0",
    "@arkade-os/sdk": ">=0.4.15",
    "react": ">=18.0.0",
    "sats-connect": ">=4.0.0"
  },
  "dependencies": {
    "@arkade-os/sats-connect": "workspace:*"
  },
  "devDependencies": {
    "@arkade-os/boltz-swap": "^0.3.44",
    "@arkade-os/sdk": "^0.4.39",
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "rimraf": "^5.0.0",
    "sats-connect": "^4.2.1",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arkade-os/packages.git",
    "directory": "packages/sats-connect-react"
  },
  "keywords": [
    "arkade",
    "bitcoin",
    "sats-connect",
    "xverse",
    "react",
    "wallet"
  ]
}
