{
  "name": "@arkade-os/checkout",
  "version": "0.1.0",
  "description": "Checkout widget to accept Bitcoin payments for Next.js using Arkade SDK + Boltz swaps",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server/route": {
      "import": {
        "types": "./dist/server/route.d.ts",
        "default": "./dist/server/route.js"
      },
      "require": {
        "types": "./dist/server/route.d.cts",
        "default": "./dist/server/route.cjs"
      }
    },
    "./next-plugin": {
      "import": {
        "types": "./dist/next-plugin.d.ts",
        "default": "./dist/next-plugin.js"
      },
      "require": {
        "types": "./dist/next-plugin.d.cts",
        "default": "./dist/next-plugin.cjs"
      }
    }
  },
  "files": [
    "dist",
    "cli",
    "README.md",
    "VSS_SETUP.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arkade-os/sdk": "^0.4.39",
    "@arkade-os/boltz-swap": "^0.3.44",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arkade-os/packages.git",
    "directory": "packages/checkout"
  },
  "keywords": [
    "arkade",
    "checkout",
    "lightning",
    "bitcoin",
    "boltz",
    "nextjs",
    "payment"
  ]
}
