# ===============================================
# Arkade Snap Configuration
# ===============================================
#
# This file configures which MetaMask Snap the dapp will connect to.
#
# VITE_SNAP_ID: The identifier for the MetaMask Snap
#   - For local development: local:http://localhost:8080
#   - For production: npm:@arkade-os/snap
#
# VITE_SNAP_VERSION: The version range for npm snaps (ignored for local snaps)
#   - Accepts any valid semver range: >=0.1.0, ^0.1.0, 0.1.2, etc.
#   - Default: >=0.1.0 (accepts any version 0.1.0 or higher)
#
# The VITE_ prefix is required for Vite to expose the variable to the browser.
#
# Copy this file to .env.development or .env.production and uncomment
# the appropriate line for your environment.

# For local development with snap running on localhost:8080
VITE_SNAP_ID=local:http://localhost:8080

# For production deployment using the published npm package
# VITE_SNAP_ID=npm:@arkade-os/snap
# VITE_SNAP_VERSION=>=0.1.0

# To pin to a specific version:
# VITE_SNAP_ID=npm:@arkade-os/snap
# VITE_SNAP_VERSION=0.1.2

# ===============================================
# Environment-specific configurations
# ===============================================
#
# Development: Copy this to .env.development
# Production:  Copy this to .env.production
#
# Or set the environment variable directly:
#   export VITE_SNAP_ID=npm:@arkade-os/snap
#   export VITE_SNAP_VERSION=>=0.1.0
#   pnpm build
