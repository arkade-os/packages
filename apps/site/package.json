{
  "name": "arkade-site",
  "version": "0.1.0",
  "private": true,
  "description": "Arkade Wallet - Modern Bitcoin Layer 2 Portfolio Dapp",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "start": "vite --port 8000",
    "preview": "vite preview",
    "lint": "pnpm lint:eslint && pnpm lint:misc --check",
    "lint:eslint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "pnpm lint:eslint --fix && pnpm lint:misc --write",
    "lint:misc": "prettier '**/*.{json,css}' --ignore-path ../../.prettierignore",
    "format": "pnpm lint:misc --write && pnpm lint:eslint --fix",
    "format:check": "pnpm lint:misc --check"
  },
  "dependencies": {
    "@metamask/providers": "^18.3.0",
    "@metamask/sdk": "^0.33.1",
    "@scure/base": "^2.0.0",
    "@scure/btc-signer": "^2.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-icons": "^5.0.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.7.3",
    "vite": "^5.0.0"
  }
}
