{
  "name": "arkade-packages",
  "version": "0.1.0",
  "private": true,
  "description": "Arkade packages for the web - wallet integrations, checkout, swaps, and more",
  "repository": {
    "type": "git",
    "url": "https://github.com/arkade-os/packages.git"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "build:checkout": "pnpm -r --filter @arkade-os/checkout... build",
    "start": "pnpm -r --parallel start",
    "clean": "pnpm -r clean",
    "test": "pnpm --filter './packages/**' -r test",
    "lint": "pnpm --filter './packages/**' -r lint",
    "lint:fix": "pnpm --filter './packages/**' -r lint:fix",
    "format": "pnpm --filter './packages/**' -r format",
    "format:check": "pnpm --filter './packages/**' -r format:check"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint-plugin-prettier": "^5.5.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b",
  "dependencies": {
    "@arkade-os/boltz-swap": "0.2.1-alpha.7",
    "@arkade-os/sdk": "0.3.1-alpha.7"
  }
}
