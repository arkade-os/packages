{
  "name": "arkade-wallet-connectors",
  "version": "0.1.0",
  "private": true,
  "description": "Browser wallet connectors for Arkade - MetaMask Snap, Sats Connect, and a shared provider interface",
  "repository": {
    "type": "git",
    "url": "https://github.com/arkade-os/wallet-connectors.git"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "start": "pnpm -r --parallel start",
    "clean": "pnpm -r clean",
    "test": "pnpm --filter './packages/**' -r test",
    "lint": "pnpm --filter './packages/**' -r lint",
    "lint:fix": "pnpm --filter './packages/**' -r lint:fix",
    "format": "pnpm --filter './packages/**' -r format",
    "format:check": "pnpm --filter './packages/**' -r format:check"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint-plugin-prettier": "^5.5.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
}
